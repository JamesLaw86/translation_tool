<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:TranslationTool.Services"
             x:Class="TranslationTool.MainPage"
             Title="French Alternatives">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings" Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">

        <Border Grid.Row="0" Padding="8,0" StrokeShape="RoundRectangle 8">
            <Editor x:Name="InputEditor"
                    Placeholder="Type something in English..."
                    AutoSize="TextChanges"
                    MinimumHeightRequest="90"
                    MaximumHeightRequest="200" />
        </Border>

        <Button Grid.Row="1"
                x:Name="TranslateButton"
                Text="Show me the French"
                Clicked="OnTranslateClicked" />

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />
            <Label x:Name="StatusLabel" IsVisible="False" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="3" x:Name="ResultsView" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:FrenchAlternative">
                    <Border Padding="12" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResultTapped" CommandParameter="{Binding French}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Register}"
                                   FontSize="12"
                                   TextTransform="Uppercase"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding French}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Note}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
